# nginx reverse proxy for the Puppeteer relay (Topology B, INT-002).
#
# TLS is terminated here (SEC-009 / CON-03: WSS only to the Internet); the relay
# itself listens on 127.0.0.1:8787 and never holds a certificate.
#
# Drop this into a server block for your relay subdomain.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Per-client-IP caps in front of the relay. Every socket may send frames before
# it authenticates, so bound how many one address can open, and how fast.
# A Host keeps one socket and each Controller tab one more; raise the numbers if
# many devices share one NAT address.
limit_conn_zone $binary_remote_addr zone=relay_conn:10m;
limit_req_zone  $binary_remote_addr zone=relay_req:10m rate=5r/s;

server {
    listen 443 ssl http2;
    server_name relay.example.com;   # <-- your relay subdomain

    ssl_certificate     /etc/letsencrypt/live/relay.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;

    # Reject plaintext: no ws:// to the Internet (CON-03).
    # (Redirect :80 -> :443 in a separate server block.)

    location /ws {
        proxy_pass http://127.0.0.1:8787;

        limit_conn relay_conn 10;
        # Counts WebSocket upgrades (one request each), not frames inside them.
        limit_req  zone=relay_req burst=20 nodelay;
        limit_conn_status 429;
        limit_req_status  429;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;

        # Long-lived WebSocket: keep the tunnel open for streaming.
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering     off;
    }
}
