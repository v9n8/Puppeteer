# Puppeteer Remote Control Relay — systemd unit (Topology B).
#
# Runs as an unprivileged user behind nginx/apache (SEC-010 / CON-02).
# Restart=always with a short window satisfies NFR-006 (recover within <=10s).
#
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin puppeteerrelay
#   sudo install -m 0755 puppeteer-relay /usr/local/bin/puppeteer-relay
#   sudo install -m 0640 -o puppeteerrelay -g puppeteerrelay relay.env /etc/puppeteer-relay.env
#   sudo cp relay.service /etc/systemd/system/puppeteer-relay.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now puppeteer-relay
#
# The auth token lives ONLY in /etc/puppeteer-relay.env (chmod 0640), never in this
# unit and never in the repo (SEC-001).

[Unit]
Description=Puppeteer Remote Control Relay (WSS bridge, localhost)
Documentation=https://github.com/puppeteer/relay
After=network-online.target
Wants=network-online.target
# Never stop restarting (NFR-006). This is a [Unit] option; systemd ignores it
# under [Service] and keeps the default start limit.
StartLimitIntervalSec=0

[Service]
Type=simple
User=puppeteerrelay
Group=puppeteerrelay

# Secrets and tunables are read from this env file (not committed).
EnvironmentFile=/etc/puppeteer-relay.env
# Sensible defaults; override in the env file.
Environment=RELAY_BIND=127.0.0.1:8787
Environment=RUST_LOG=info

ExecStart=/usr/local/bin/puppeteer-relay

# Reliability (NFR-006): recover within <=10s after a crash.
Restart=always
RestartSec=2s

# Resource limits (NFR-002/CON-02): keep the relay small.
MemoryMax=128M
CPUQuota=50%
TasksMax=256
LimitNOFILE=8192

# Hardening (SEC-010): least privilege, no new privileges, read-only FS.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
