#!/usr/bin/env node
// Puppeteer scp shim — see ssh-shim.mjs. Named exactly `scp` so it intercepts `scp`
// calls when this directory is prepended to the sidecar PATH. Inserts
// `-F $PUPPETEER_SSH_CONFIG` when set, else behaves like the real scp (BR-304).
import { run } from './ssh-shim.mjs'

run('scp')
