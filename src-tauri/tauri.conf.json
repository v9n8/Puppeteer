{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Puppeteer",
  "version": "0.13.0",
  "identifier": "io.github.v9n8.puppeteer",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "beforeBundleCommand": "node scripts/ensure-sidecar-deps.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Puppeteer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "resources": {
      "../sidecar": "sidecar",
      "../sidecar-codex": "sidecar-codex",
      "../sidecar-proxy": "sidecar-proxy",
      "../sidecar-mcp": "sidecar-mcp"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/v9n8/Puppeteer/releases/latest/download/latest.json"]
    }
  }
}
